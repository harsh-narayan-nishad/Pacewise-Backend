{
  "name": "speed-reader-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Pacewise (speed reader + docs) \u2014 Express + TypeScript + MongoDB.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "seed": "tsx scripts/seed-demo-users.ts",
    "test": "tsx --test src/modules/sync/policy.test.ts src/modules/tracking/consistency.test.ts src/modules/auth/auth.schema.test.ts src/modules/admin/admin.policy.test.ts src/modules/history/topics.test.ts src/modules/weekly/weekly.compute.test.ts src/modules/calendar/calendar.schema.test.ts",
    "mail:test": "tsx scripts/send-test-mail.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "report:weekly": "tsx scripts/send-weekly-reports.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "ms": "^2.1.3",
    "nodemailer": "^6.9.14",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "pino-pretty": "^11.2.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.0"
  }
}
