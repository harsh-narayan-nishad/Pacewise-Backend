
MONGODB_URI=mongodb://localhost:27017/pacewise

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pacewise <your-address@gmail.com>"

# Address of the WEB APP (links inside e-mails open here). Local: http://localhost:3000
APP_URL=http://localhost:3000

REQUIRE_EMAIL_VERIFICATION=false

REQUIRE_ADMIN_APPROVAL=true

# ---------- 3. OTHER SETTINGS (defaults are fine) -------------------------------------
NODE_ENV=development
PORT=4000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Web app address(es) allowed to call this API (comma separated).
# The admin app runs on port 3001, so it must be listed too.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- 4. OPTIONAL ---------------------------------------------------------------
# Redis: only when you run several API instances (shared rate limits + live notifications).
# REDIS_URL=redis://localhost:6379
# S3 storage: only for PDF/image uploads (/uploads answers 503 until all are set).
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
